<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.boxtools"
    android:versionCode="25"
    android:versionName="1.23">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Lets MiniCarHome (same signing key) close an app window through the gesture service, and lets MiniCarHome
         and MiniMap (com.kynrek.osmandbox, its own key, listed in known_certs) arrange windows through ShellProvider. -->
    <permission android:name="local.boxtools.permission.CONTROL"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/known_certs" />

    <!-- Not grantable at install; granted once over ADB: pm grant local.boxtools android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Shell commands for MiniCarHome through the box's own adbd on 127.0.0.1:5555 (see ShellBridge). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Recent apps: icons and names of the apps in it. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:label="Box Tools" android:icon="@drawable/ic_wifi_debug" android:allowBackup="false">

        <activity android:name=".StockHomeActivity"
            android:label="Stock Home"
            android:icon="@drawable/ic_home"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WirelessDebugActivity"
            android:label="Wireless Debug"
            android:icon="@drawable/ic_wifi_debug"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CarAudioActivity"
            android:label="Car Audio Awake"
            android:icon="@drawable/ic_car_audio"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MiniCarHome's and MiniMap's window handling: runs commands as the shell user. call() checks for CONTROL itself. -->
        <provider android:name=".ShellProvider"
            android:authorities="local.boxtools.shell"
            android:permission="local.boxtools.permission.CONTROL"
            android:exported="true" />

        <!-- At every boot, independent of the accessibility service: ADB on, and the service back on after a crash. -->
        <receiver android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Enabled over ADB: settings put secure enabled_accessibility_services local.boxtools/.NavGestureService -->
        <service android:name=".NavGestureService"
            android:label="@string/nav_gesture_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/nav_gesture_service" />
        </service>
    </application>
</manifest>
